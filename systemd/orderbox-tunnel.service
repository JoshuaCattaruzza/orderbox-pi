[Unit]
Description=OrderBox reverse SSH tunnel
After=network-online.target
Wants=network-online.target

[Service]
User=pi
ExecStart=/usr/local/bin/autossh -M 0 -N \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o ExitOnForwardFailure=yes \
  -o StrictHostKeyChecking=no \
  -i /home/pi/.ssh/orderbox_tunnel \
  -R 2222:localhost:22 \
  josh@34.89.22.14
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
