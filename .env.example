ORDERBOX_API_URL=http://your-api-url
ORDERBOX_SUBDOMAIN=demo
ORDERBOX_PI_API_KEY=

# Remote port this Pi's reverse SSH tunnel binds on the VM (systemd/orderbox-tunnel.service).
# Every Pi needs a UNIQUE value here — two Pis forwarding to the same port will collide.
# Check orderbox-ops.md for the next unused port before assigning one to a new Pi.
TUNNEL_PORT=2222

PRINTER_DEV=/dev/usb/lp0

POLL_INTERVAL=10

NOTIFICATION_SOUND_ENABLED=true
